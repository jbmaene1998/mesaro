SPRING_PROFILES_ACTIVE=dev

# Dev database (separate from prod)
DB_URL=jdbc:postgresql://localhost:5432/mesaro_dev
DB_USER=mesaro
DB_PASS=mesaro

# Redis (optional in dev if SESSION_STORE_TYPE=none)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_STORE_TYPE=none

# Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
APP_LOG_ELASTIC_ENABLED=true
APP_LOG_ELASTIC_INDEX=mesaro-api-actions-dev

# Dev-safe token secrets (replace if needed)
JWT_SECRET=insecure-dev-jwt-secret-change-me-1234567890
HOLD_TOKEN_SECRET=insecure-dev-hold-secret-change-me-1234567890
RESERVATION_TOKEN_SECRET=insecure-dev-reservation-secret-change-me-1234567890
STAFF_TOKEN_SECRET=insecure-dev-staff-secret-change-me-1234567890

# App URLs
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email provider (choose one: log, resend, smtp)
EMAIL_PROVIDER=log
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_FROM=noreply@mesaro.local
EMAIL_FROM_NAME=Mesaro Dev

# Notification cronjobs
NOTIFICATIONS_RESERVATION_REMINDER_ENABLED=true
NOTIFICATIONS_RESERVATION_REMINDER_CRON=0 */15 * * * *
NOTIFICATIONS_RESERVATION_REMINDER_MINUTES_BEFORE=120
NOTIFICATIONS_RESERVATION_REMINDER_WINDOW_MINUTES=15
NOTIFICATIONS_BILLING_TRIAL_ENDING_ENABLED=true
NOTIFICATIONS_BILLING_TRIAL_ENDING_CRON=0 5 9 * * *
NOTIFICATIONS_BILLING_TRIAL_ENDING_DAYS_BEFORE=3
STAFF_INVITE_CLEANUP_CRON=0 0 * * * *
