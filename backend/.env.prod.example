SPRING_PROFILES_ACTIVE=prod

# Compose-internal database service settings (used by docker-compose.prod.yml)
POSTGRES_DB=mesaro_prod
POSTGRES_USER=mesaro_prod_user
POSTGRES_PASSWORD=<strong-prod-db-password>

# Production database (must be separate from dev)
DB_URL=jdbc:postgresql://postgres-prod:5432/mesaro_prod
DB_USER=mesaro_prod_user
DB_PASS=<strong-prod-db-password>
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=10

# Redis (required in prod)
REDIS_HOST=redis-prod
REDIS_PORT=6379
REDIS_PASSWORD=<strong-redis-password>
SESSION_STORE_TYPE=redis

# Elasticsearch
ELASTICSEARCH_URIS=http://elasticsearch-prod:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
KIBANA_ELASTICSEARCH_HOSTS=http://elasticsearch-prod:9200
APP_LOG_ELASTIC_ENABLED=true
APP_LOG_ELASTIC_INDEX=mesaro-api-actions-prod

# Required secrets (32+ chars each)
JWT_SECRET=<replace-with-strong-32-plus-char-secret>
HOLD_TOKEN_SECRET=<replace-with-strong-32-plus-char-secret>
RESERVATION_TOKEN_SECRET=<replace-with-strong-32-plus-char-secret>
STAFF_TOKEN_SECRET=<replace-with-strong-32-plus-char-secret>

# App URLs / CORS
APP_BASE_URL=https://api.your-domain.com
API_BASE_URL=https://api.your-domain.com
FRONTEND_URL=https://app.your-domain.com
API_CORS_ORIGINS=https://app.your-domain.com

# Email provider (choose one: resend or smtp)
EMAIL_PROVIDER=resend

# Resend provider
RESEND_API_KEY=<re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx>
RESEND_API_BASE_URL=https://api.resend.com

# SMTP provider (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=<smtp.host.tld>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Mesaro

# Notification cronjobs
NOTIFICATIONS_RESERVATION_REMINDER_ENABLED=true
NOTIFICATIONS_RESERVATION_REMINDER_CRON=0 */15 * * * *
NOTIFICATIONS_RESERVATION_REMINDER_MINUTES_BEFORE=120
NOTIFICATIONS_RESERVATION_REMINDER_WINDOW_MINUTES=15
NOTIFICATIONS_BILLING_TRIAL_ENDING_ENABLED=true
NOTIFICATIONS_BILLING_TRIAL_ENDING_CRON=0 5 9 * * *
NOTIFICATIONS_BILLING_TRIAL_ENDING_DAYS_BEFORE=3
STAFF_INVITE_CLEANUP_CRON=0 0 * * * *
