SPRING_PROFILES_ACTIVE=prod
MESARO_DOMAIN=mesaro.localhost
ACME_EMAIL=local@mesaro.localhost
FRONTEND_DIST_PATH=./frontend-dist
MANAGEMENT_PORT=9090

# Compose-internal database
POSTGRES_DB=mesaro_prod
POSTGRES_USER=mesaro_prod_user
POSTGRES_PASSWORD=local-prod-db-change-me-32chars!!

DB_URL=jdbc:postgresql://postgres-prod:5432/mesaro_prod
DB_USER=mesaro_prod_user
DB_PASS=local-prod-db-change-me-32chars!!
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=10

# Redis
REDIS_HOST=redis-prod
REDIS_PORT=6379
REDIS_PASSWORD=local-prod-redis-change-me-32chars!!
SESSION_STORE_TYPE=redis

# Elasticsearch off for lighter local prod (enable with --profile elastic if needed)
ELASTICSEARCH_URIS=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_HEALTH_ENABLED=false
APP_LOG_ELASTIC_ENABLED=false

# Required secrets (32+ chars, not insecure-dev-*)
JWT_SECRET=local-prod-jwt-secret-abcdefghijklmnopqrstuvwxyz01
HOLD_TOKEN_SECRET=local-prod-hold-secret-abcdefghijklmnopqrstuvwxyz01
RESERVATION_TOKEN_SECRET=local-prod-reservation-secret-abcdefghijklmnopqrstu01
STAFF_TOKEN_SECRET=local-prod-staff-secret-abcdefghijklmnopqrstuvwxyz01

# URLs through local Caddy (HTTPS on 9443)
APP_BASE_URL=https://api.mesaro.localhost:9443
API_BASE_URL=https://api.mesaro.localhost:9443
FRONTEND_URL=https://app.mesaro.localhost:9443
API_CORS_ORIGINS=https://app.mesaro.localhost:9443

# Mail → Mailpit (UI http://127.0.0.1:8025)
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
EMAIL_FROM=noreply@mesaro.localhost
EMAIL_FROM_NAME=Mesaro Local Prod

# Stripe test mode — Mesaro product price_1T280aJ5Zfjtr4Ikkn6ou5Xg (€49.99/restaurant/month, licensed quantity)
STRIPE_SECRET_KEY=sk_test_replace_with_dashboard_or_env_dev_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_listen_or_dashboard_secret
STRIPE_PRICE_ID=price_1T280aJ5Zfjtr4Ikkn6ou5Xg
STRIPE_SUCCESS_URL=https://app.mesaro.localhost:9443/billing/success
STRIPE_CANCEL_URL=https://app.mesaro.localhost:9443/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://app.mesaro.localhost:9443/settings/billing
