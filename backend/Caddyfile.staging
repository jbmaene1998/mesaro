# Staging on LAN — TLS via Caddy internal CA (no public ACME).
# On clients, point app.mesaro.staging and api.mesaro.staging at the server LAN IP.

{
	auto_https disable_redirects
	local_certs
}

https://api.mesaro.staging {
	tls internal
	encode gzip
	reverse_proxy app-prod:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

https://app.mesaro.staging {
	tls internal
	encode gzip
	root * /srv/frontend
	try_files {path} /index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
