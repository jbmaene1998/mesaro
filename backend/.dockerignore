# =============================================================================
# Docker Ignore File
# =============================================================================
# Files and directories to exclude from Docker build context
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# IDE
.idea/
*.iml
.vscode/
*.code-workspace

# Build outputs
target/
!target/*.jar
build/
out/

# Logs
*.log
logs/

# Documentation
docs/
*.md
!README.md

# Docker files (not needed in build context)
docker-compose*.yml
Dockerfile*

# Environment files
.env
.env.*
*.env

# Test files
src/test/

# OS files
.DS_Store
Thumbs.db

# Maven wrapper downloaded files
.mvn/wrapper/maven-wrapper.jar
